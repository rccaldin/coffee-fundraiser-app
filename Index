</head>
<body>

<div id="app">
    <header>
        <h1>🎪 Church Grounds Coffee</h1>
        <p>Specialty Macchiato Station</p>
    </header>

    <div class="container">
        <div class="view-toggle">
            <button :class="{ active: currentView === 'customer' }" @click="currentView = 'customer'">📱 Customer Form</button>
            <button :class="{ active: currentView === 'kitchen' }" @click="currentView = 'kitchen'">☕ Barista Queue ({{ activeOrdersCount }})</button>
        </div>

        <!-- CUSTOMER FORM -->
        <div v-if="currentView === 'customer'">
            <div v-if="submittedMessage" class="success-banner">
                🎉 {{ submittedMessage }}
            </div>

            <div class="card">
                <h2>Place Your Macchiato Order</h2>
                
                <div class="form-group">
                    <label>Your Name</label>
                    <input type="text" v-model="form.name" placeholder="Enter name for your cup" required>
                </div>

                <div class="form-group">
                    <label>Select Your Drink</label>
                    <div class="radio-tile-group">
                        <div v-for="item in menu" :key="item" 
                             class="radio-tile" 
                             :class="{ selected: form.drink === item }"
                             @click="form.drink = item">
                            {{ item }}
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Milk Choice</label>
                    <select v-model="form.milk">
                        <option value="Whole Milk">Whole Milk</option>
                        <option value="Almond Milk">Almond Milk</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Comments / Special Instructions</label>
                    <input type="text" v-model="form.comment" placeholder="Example: no cinnamon, extra caramel, etc.">
                </div>

                <button class="btn-submit" @click="submitOrder" :disabled="!form.name || !form.drink">
                    🚀 Submit Order to Booth
                </button>
            </div>
        </div>

        <!-- BARISTA QUEUE VIEW -->
        <div v-if="currentView === 'kitchen'">
            <div class="card">
                <h2>Active Orders Queue</h2>
                <div v-if="activeOrders.length === 0" class="empty-state">
                    ☕ No pending orders. Time to build layers!
                </div>
                <div v-for="order in activeOrders" :key="order.id" class="queue-item">
                    <div class="order-meta">
                        <h3 class="order-title">{{ order.name }}</h3>
                        <div class="order-details">
                            <strong>{{ order.drink }}</strong> — <u>{{ order.milk }}</u>
                        </div>
                        <div v-if="order.comment" class="order-comment">
                            ⚠️ Instructions: {{ order.comment }}
                        </div>
                        <div class="order-time">Ordered at {{ order.time }}</div>
                    </div>
                    <div>
                        <button class="btn-complete" @click="toggleComplete(order.id)">Done ✓</button>
                    </div>
                </div>
            </div>

            <div class="card" style="background: #fdfdfd;">
                <h2 style="color: #888; font-size: 1.1rem;">Completed Items</h2>
                <div v-if="completedOrders.length === 0" class="empty-state" style="padding: 1rem;">
                    No completed items yet.
                </div>
                <div v-for="order in completedOrders" :key="order.id" class="queue-item completed">
                    <div class="order-meta">
                        <h3 class="order-title">{{ order.name }}</h3>
                        <div class="order-details">{{ order.drink }} ({{ order.milk }})</div>
                    </div>
                    <div>
                        <button class="btn-complete undo" @click="toggleComplete(order.id)">Undo</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

