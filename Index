        .order-time { font-size: 0.75rem; color: #888; margin-top: 0.3rem; }
        
        .btn-complete {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
        }
        .btn-complete.undo {
            background-color: #6c757d;
        }
        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: #888;
        }
        
        .success-banner {
            background-color: #e8f5e9;
